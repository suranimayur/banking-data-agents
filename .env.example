# ---------------------------------------------------------------------------
# BDA configuration. Copy to .env for local work.
# `cp .env.example .env`
# ---------------------------------------------------------------------------

ENV=local
AWS_REGION=us-east-1

# --- Local (Floci) credentials. Any non-empty values are accepted. ---------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Point boto3 at Floci. Leave EMPTY / unset to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# --- Storage buckets -------------------------------------------------------
BDA_BRONZE_BUCKET=bda-bronze
BDA_SILVER_BUCKET=bda-silver
BDA_GOLD_BUCKET=bda-gold
BDA_OPS_BUCKET=bda-ops
BDA_ARTIFACTS_BUCKET=bda-artifacts

# --- Catalog / query -------------------------------------------------------
BDA_SILVER_DB=bda_silver
BDA_GOLD_DB=bda_gold
BDA_OPS_DB=bda_ops
BDA_BRONZE_DB=bda_bronze
ATHENA_WORKGROUP=bda-agents
ATHENA_BYTES_CAP_MB=512
ATHENA_QUERY_TIMEOUT_S=30

# --- Synthetic data --------------------------------------------------------
SYNTHETIC_SEED=20260928
SYNTHETIC_CUSTOMERS=2000
SYNTHETIC_ACCOUNTS=3200
SYNTHETIC_LOANS=1200
SYNTHETIC_CARDS=1800
SYNTHETIC_MONTHS=12
SYNTHETIC_FRAUD_RATE=0.004

# --- LLM provider selection ------------------------------------------------
# stub   : deterministic canned completions (tests + CI, free, reproducible)
# floci  : Bedrock Runtime emulated by Floci (proves the AWS wiring offline)
# bedrock: real Amazon Bedrock (requires AWS credentials with model access)
LLM_PROVIDER=stub
BEDROCK_MODEL_ROUTER=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_REASONER=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ESCALATION=anthropic.claude-3-opus-20240229-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# --- Agent budgets ---------------------------------------------------------
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOKENS=60000
AGENT_MAX_WALL_CLOCK_S=45
SESSION_BUDGET_USD=0.50
USER_DAILY_BUDGET_USD=5.00
